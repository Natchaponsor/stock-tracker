{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "stock-tracker-dev",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": [
        "-c",
        "export PATH=/opt/homebrew/bin:$PATH && npm run dev"
      ],
      "port": 3001
    },
    {
      "name": "stock-tracker-lan",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": [
        "-c",
        "export PATH=/opt/homebrew/bin:$PATH && npx next start -H 0.0.0.0 -p 3012"
      ],
      "port": 3012,
      "autoPort": false
    },
    {
      "name": "stock-tracker-dev-webpack",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": [
        "-c",
        "export PATH=/opt/homebrew/bin:$PATH && npx next dev --webpack -p 3002"
      ],
      "port": 3002
    }
  ]
}