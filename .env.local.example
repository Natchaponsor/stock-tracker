# Copy this file to .env.local (gitignored) and fill in your own key.
# Get a free API key at https://finnhub.io/register — no cost, no credit card.
FINNHUB_API_KEY=

# Optional: device sync storage (Upstash Redis). Leave unset in development to use
# an in-memory store; production needs them. Vercel sets these when you connect
# an Upstash Redis database to the project.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: FX push alerts (opt-in, see docs/fx-analysis.md §5). Generate a key pair once with
#   npx web-push generate-vapid-keys
# and set CRON_SECRET to a long random string (Vercel Cron sends it to /api/cron/fx-alerts).
# Push also needs the Upstash Redis settings above in production.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# CRON_SECRET=
