# Copy this file to .env.local (gitignored) and fill in your own key.
# Get a free API key at https://finnhub.io/register — no cost, no credit card.
FINNHUB_API_KEY=

# Optional: device sync storage (Upstash Redis). Leave unset in development to use
# an in-memory store; production needs them. Vercel sets these when you connect
# an Upstash Redis database to the project.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
